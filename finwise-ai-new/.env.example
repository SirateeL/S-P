# Documentation only: Flask does NOT load this file automatically.
# Local mode remains loopback-only. Set production before any hosted use.
FINWISE_ENV=local
# Generate hashes with Werkzeug; usernames are admin and optionally viewer.
FINWISE_ADMIN_PASSWORD_HASH=
FINWISE_VIEWER_PASSWORD_HASH=
# Required in production. Reverse proxy must preserve this hostname.
# Example for production: https://finwise.example.com
FINWISE_PUBLIC_ORIGIN=
# Keep the existing data path; do not delete/reindex the existing database.
# FINWISE_DATA_DIR=/absolute/path/to/existing/data
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
EMBEDDING_MODEL=nomic-embed-text
